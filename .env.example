# =========================================================================
# ENORA LIVE AI CLASSROOM PRO - Environment Variables
# Platform: Vercel Serverless Functions (Node.js)
# =========================================================================
#
# HOW STORAGE WORKS (priority order):
#   1. Supabase PostgreSQL  — if SUPABASE_URL + SUPABASE_SERVICE_KEY set
#   2. Upstash Redis / KV   — if UPSTASH_REDIS_REST_URL + TOKEN set
#   3. /tmp filesystem      — always available as local fallback
#   4. Bundled seed data    — data/db.json and data/auth.json (read-only)
#
# The app works immediately out of the box with ZERO configuration,
# using bundled seed data. Add Supabase for persistent cloud storage.
#
# =========================================================================
# OPTION 1: Supabase PostgreSQL (RECOMMENDED — Persistent Cloud Database)
# 1. Create a free project at https://supabase.com
# 2. Run the SQL migration: supabase/migrations/001_initial_schema.sql
# 3. Get your keys from: Supabase Dashboard → Project Settings → API
# =========================================================================

SUPABASE_URL=your_supabase_project_url_here

# Publishable anon key (safe to expose in frontend, limited access)
SUPABASE_KEY=your_supabase_anon_key_here

# SERVICE ROLE key — REQUIRED for backend persistence
# NEVER expose this in frontend code. Backend (api/index.js) only.
# This key bypasses RLS and has full database access.
SUPABASE_SERVICE_KEY=

# =========================================================================
# OPTION 2: Upstash Redis / Vercel KV (Alternative KV Store)
# https://upstash.com or Vercel Marketplace (Storage → KV)
# =========================================================================
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Standard Vercel KV env vars (auto-populated by Vercel KV integration):
# KV_REST_API_URL=https://your-kv-instance.upstash.io
# KV_REST_API_TOKEN=your_kv_rest_token_here

# =========================================================================
# OPTION 3: Google Gemini API (Optional — AI features)
# Students/Admins can also configure this directly in the UI
# =========================================================================
# GEMINI_API_KEY=AIzaSy...

# =========================================================================
# VERCEL ENVIRONMENT VARIABLES SETUP
# 1. Go to: Vercel Dashboard → Your Project → Settings → Environment Variables
# 2. Add: SUPABASE_URL, SUPABASE_KEY, SUPABASE_SERVICE_KEY
# 3. Set scope: Production + Preview + Development
# 4. Redeploy the project for variables to take effect
# =========================================================================
